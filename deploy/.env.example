# systemd EnvironmentFile syntax: KEY=value, no "export" prefix.
# Replace placeholders on the server only; never commit real credentials.
ZERODHA_API_KEY=replace_with_your_kite_api_key
ZERODHA_API_SECRET=replace_with_your_kite_api_secret
ZERODHA_REDIRECT_URL=https://stockpi.vkotian.com/api/zerodha/callback
FRONTEND_URL=https://stockpi.vkotian.com
# Use SIMULATED for first deployment; switch to ZERODHA when configured.
MARKET_DATA_MODE=SIMULATED
EXECUTION_MODE=PAPER
DATABASE_PATH=/opt/stockpi/data/stockpi.db

LEVEL_REARM_DISTANCE_POINTS=50
