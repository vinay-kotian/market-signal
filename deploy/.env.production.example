APP_NAME=Market Signal

# Keep production safe until live trading is explicitly designed and enabled.
TRADING_MODE=PAPER
ENABLE_LIVE_TRADING=false
BROKER=ZERODHA

DATABASE_URL=sqlite:////app/data/market_signal.db
SQUARE_OFF_TIME=15:15

# Replace with your deployed URL.
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# Configure these on the server only. Do not commit real secrets.
KITE_API_KEY=
KITE_API_SECRET=
KITE_REDIRECT_URL=https://your-domain.com/zerodha/callback
